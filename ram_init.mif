-- Quartus II generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    -- [地址] : [机器码];  -- 注释(汇编)
    
    -- 00: JMP (R3), 此时 R3=07, 所以跳到地址 07
    00 : A3; 
    
    -- 01: 数据区, 初始存 11H (用于后续测试)
    01 : 11; 

    -- [02..06] 空白区
    [02..06] : 00;

    -- 07: IN R1 (从外部读入 01H) -> R1=01
    07 : C4; 
    
    -- 08: MOVA R2, R1 -> R2=01
    08 : 49; 
    
    -- 09: MOVC R1, M (读取RAM[R0], R0=01, RAM[01]=11) -> R1=11
    09 : 64; 
    
    -- 0A: SUB R1, R2 (11-01=10, 结果>0, G=1) -> R1=10H
    0A : 96; 
    
    -- 0B: MOVD R3, PC (PC当前是0C) -> R3=0C
    0B : 7C; 
    
    -- 0C: ADD R3, R1 (0C+10=1C) -> R3=1CH
    0C : 8D; 
    
    -- 0D: JG (R3) (因G=1, 跳到 R3=1C 地址)
    0D : B3; 

    -- [0E..1B] 空白区 (被跳过)
    [0E..1B] : 00;

    -- 1C (地址28): MOVB M, R3 (将 R3=1C 写入 RAM[R0=01])
    1C : 53; 
    
    -- 1D: MOVC R1, M (读回 RAM[01] 验证, R1=1C)
    1D : 64; 
    
    -- 1E: MOVI #09 (立即数 09 给 R0) -> R0=09
    1E : E0; 
    1F : 09; 
    
    -- 20: SUB R0, R1 (09-1C = ED负数, G=0) -> R0=ED
    20 : 91; 
    
    -- 21: JG (R3) (因G=0, 不跳转, 继续执行)
    21 : B3; 
    
    -- 22: OUT R0 (输出 R0=EDH)
    22 : D0; 
    
    -- 23: HALT (停机)
    23 : F0; 
    
    -- 24: JMP (测试停机是否成功, 应该不执行)
    24 : A3; 

    -- 其余填充 00
    [25..FF] : 00;
END;